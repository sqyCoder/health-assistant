# ============================================
# 智能健康助手 环境变量模板
# 使用方法：复制本文件为 .env 并填入真实值
# ============================================

# ---------- 数据库（Supabase Session Pooler） ----------
# Dashboard -> Connect -> Session pooler 连接串
SUPABASE_DB_URL=jdbc:postgresql://aws-0-ap-southeast-1.pooler.supabase.com:5432/postgres?sslmode=require
# 注意：Supabase Session Pooler 的用户名格式为 postgres.<project-ref>
SUPABASE_DB_USER=postgres.<project-ref>
SUPABASE_DB_PASSWORD=change-me

# ---------- 对象存储（Supabase Storage REST API） ----------
STORAGE_TYPE=supabase
# 项目地址，Project Settings -> API -> Project URL
SUPABASE_URL=https://<project-ref>.supabase.co
# Project Settings -> API -> service_role secret（服务端专用，切勿泄露）
SUPABASE_SERVICE_ROLE_KEY=change-me
SUPABASE_BUCKET_REPORTS=health-reports
SUPABASE_BUCKET_EXPORTS=health-exports

# ---------- DeepSeek ----------
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_API_KEY=sk-change-me
DEEPSEEK_MODEL=deepseek-chat
DEEPSEEK_PRICE_INPUT_PER_M=2.0
DEEPSEEK_PRICE_OUTPUT_PER_M=8.0

# ---------- 应用 ----------
# 生产环境必须替换为至少 32 字节的随机字符串
JWT_SECRET=change-me-to-a-random-string-at-least-32-bytes
JWT_ACCESS_EXPIRE_MINUTES=120
JWT_REFRESH_EXPIRE_DAYS=7
AI_DAILY_LIMIT_PER_USER=3
MAX_USERS=10
